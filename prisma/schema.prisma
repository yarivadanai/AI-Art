generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id             String     @id @default(cuid())
  seed           String
  startedAt      DateTime   @default(now())
  expiresAt      DateTime
  /// Intake belief answers ({ [beliefId]: 1..5 }); quoted back on the report.
  beliefs        Json?
  /// "human" for visitors; reserved for machine cohorts (e.g. "llm", "reference") on the dashboard.
  cohort         String     @default("human")
  /// "fixed" = 25 pre-generated bank items (pre-Phase-2); "adaptive" = staircase per domain (lib/engine/adaptive.ts).
  mode           String     @default("fixed")
  /// Adaptive engine state (AdaptiveState in lib/engine/adaptive.ts); null for fixed sessions.
  state          Json?
  questions      Question[]
  responses      Response[]
  result         Result?
}

model Question {
  id        String     @id @default(cuid())
  sessionId String
  section   String
  index     Int
  type      String
  payload   Json
  /// { hash, normalization, decimalPlaces?, reference? } - server-only, never sent to the client before grading.
  answerKey Json
  session   Session    @relation(fields: [sessionId], references: [id])
  responses Response[]

  @@index([sessionId])
}

model Response {
  id         String   @id @default(cuid())
  questionId String
  sessionId  String
  answer     Json
  correct    Boolean
  score      Float    @default(0)
  timeMs     Int
  /// Self-reported confidence: "sure" | "unsure" | "guess" | "expired" | null (not stated).
  confidence String?
  /// The visitor pressed "I cannot determine this" instead of answering.
  abstained  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id])
  session    Session  @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@index([questionId])
}

model Result {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  sectionScores Json
  overall       Float
  verdict       String
  commentary    Json
  /// Calibration and timing summary (see lib/engine/metrics.ts) - stored so /api/stats can aggregate cheaply.
  metrics       Json?
  session       Session  @relation(fields: [sessionId], references: [id])
  createdAt     DateTime @default(now())
}
